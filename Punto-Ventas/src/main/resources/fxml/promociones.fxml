<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    promociones.fxml  –  Catálogo de promociones por producto
    Controlador: PromocionesController.java
    Se abre como ventana modal desde Productos → Promociones.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.PromocionesController"
            stylesheets="@../css/app.css">

    <top>
        <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <Button text="+ Nueva"     onAction="#onNueva"    styleClass="button-success"/>
            <Button text="🗑 Eliminar" onAction="#onEliminar" styleClass="button-danger"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="⭐ Promociones" styleClass="form-section-title"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.58">

            <!-- Tabla -->
            <TableView fx:id="tablaPromociones">
                <columns>
                    <TableColumn fx:id="colProducto"    text="Producto"    prefWidth="180"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="140"/>
                    <TableColumn fx:id="colTipo"        text="Tipo"        prefWidth="90"/>
                    <TableColumn fx:id="colValor"       text="Valor"       prefWidth="70" styleClass="align-right"/>
                    <TableColumn fx:id="colVigencia"    text="Vigencia"    prefWidth="190"/>
                    <TableColumn fx:id="colEstado"      text="Estado"      prefWidth="90"/>
                </columns>
            </TableView>

            <!-- Formulario -->
            <ScrollPane fitToWidth="true">
                <VBox styleClass="form-panel" spacing="12">
                    <padding><Insets topRightBottomLeft="16"/></padding>

                    <Label fx:id="lblTituloForm" text="NUEVA PROMOCIÓN" styleClass="form-section-title"/>
                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Producto *" styleClass="field-label"/>
                        <TextField fx:id="txtFiltroProducto" promptText="Filtrar por código o nombre..."
                                   onKeyReleased="#onFiltrarProducto"/>
                        <ComboBox fx:id="comboProducto" maxWidth="Infinity"
                                  promptText="Selecciona un producto"/>
                        <Label fx:id="lblPrecioActual" text="Precio actual: —"
                               style="-fx-text-fill:-color-fg-muted;-fx-font-size:11"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Descripción" styleClass="field-label"/>
                        <TextField fx:id="txtDescripcion" promptText="ej: Oferta de fin de semana"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Tipo *" styleClass="field-label"/>
                        <RadioButton fx:id="rbPorcentaje" text="Porcentaje de descuento (%)" selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="toggleTipo"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbPrecioFijo" text="Precio fijo por unidad ($)"
                                     toggleGroup="$toggleTipo"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Valor *" styleClass="field-label"/>
                        <TextField fx:id="txtValor" promptText="ej: 10  (10 %)  ó  25.50  ($)"/>
                        <Label fx:id="lblPrecioResultante" text=""
                               style="-fx-text-fill:-color-success-fg;-fx-font-size:11;-fx-font-weight:bold"/>
                    </VBox>

                    <GridPane hgap="16" vgap="8">
                        <Label text="Desde *" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="dpInicio" maxWidth="Infinity"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Hasta" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <DatePicker fx:id="dpFin" maxWidth="Infinity" promptText="Sin vencimiento"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <columnConstraints>
                            <ColumnConstraints prefWidth="80" minWidth="60"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <CheckBox fx:id="chkActiva" text="Promoción activa" selected="true"/>

                    <Region minHeight="8"/>

                    <HBox spacing="12">
                        <Button text="✅ Guardar" onAction="#onGuardar"
                                styleClass="button-success"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"/>
                        <Button text="Cerrar" onAction="#onCerrar" prefHeight="38"/>
                    </HBox>
                </VBox>
            </ScrollPane>

        </SplitPane>
    </center>

</BorderPane>
