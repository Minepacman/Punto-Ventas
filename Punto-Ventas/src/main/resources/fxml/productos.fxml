<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    productos.fxml  –  Catálogo de Productos (F3)
    Controlador: ProductosController.java
-->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="me.eliassanchezfernandez.puntodeventa.controller.ProductosController">

    <!-- ══════════════════════════════════════════════════════════════
         VISTA A – TABLA DE PRODUCTOS
    ══════════════════════════════════════════════════════════════ -->
    <BorderPane fx:id="vistaTabla">

        <!-- Toolbar + búsqueda -->
        <top>
            <VBox>

                <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
                    <padding><Insets topRightBottomLeft="10"/></padding>
                    <Button fx:id="btnNuevo"      text="+ Nuevo"
                            onAction="#onNuevo"   styleClass="button-success"/>
                    <Button fx:id="btnModificar"  text="Modificar"
                            onAction="#onModificar"><graphic><Icono nombre="editar"/></graphic></Button>
                    <Button fx:id="btnEliminar"   text="Eliminar"
                            onAction="#onEliminar" styleClass="button-danger"><graphic><Icono nombre="eliminar"/></graphic></Button>
                    <Button fx:id="btnActivar"    text="Activar / Desactivar"
                            onAction="#onCambiarActivo"><graphic><Icono nombre="energia"/></graphic></Button>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="btnDepartamentos" text="Departamentos"      onAction="#onDepartamentos"/>
                    <Button fx:id="btnVentasPeriodo" text="Ventas por Período" onAction="#onVentasPeriodo"/>
                    <Button fx:id="btnPromociones"   text="Promociones"      onAction="#onPromociones"><graphic><Icono nombre="estrella"/></graphic></Button>
                    <!-- "Importar" (desde archivo) se mostrará cuando exista; el handler onImportar queda en el controlador -->
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-row">
                    <padding><Insets top="6" right="10" bottom="8" left="10"/></padding>
                    <Label><graphic><Icono nombre="buscar"/></graphic></Label>
                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por código o descripción..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#onBuscar"/>
                </HBox>
            </VBox>
        </top>

        <!-- Tabla -->
        <center>
            <TableView fx:id="tablaProductos"
                       onMouseClicked="#onTablaDobleClick">
                <columns>
                    <TableColumn fx:id="colImagen"       text=""             prefWidth="44" minWidth="44" maxWidth="44" resizable="false"/>
                    <TableColumn fx:id="colCodigo"       text="Código"       prefWidth="140"/>
                    <TableColumn fx:id="colDescripcion"  text="Descripción"  prefWidth="260"/>
                    <TableColumn fx:id="colPrecioCosto"  text="Costo"        prefWidth="85" styleClass="align-right"/>
                    <TableColumn fx:id="colPrecioVenta"  text="Venta"        prefWidth="85" styleClass="align-right"/>
                    <TableColumn fx:id="colPrecioMayor"  text="Mayoreo"      prefWidth="85" styleClass="align-right"/>
                    <TableColumn fx:id="colExistencia"   text="Stock"        prefWidth="75" styleClass="align-right"/>
                    <TableColumn fx:id="colDepartamento" text="Departamento" prefWidth="140"/>
                    <TableColumn fx:id="colEstado"       text="Estado"       prefWidth="80"/>
                </columns>
                <placeholder>
                    <Label text="No hay productos registrados. Pulsa + Nuevo para agregar."/>
                </placeholder>
            </TableView>
        </center>

    </BorderPane>

    <!-- ══════════════════════════════════════════════════════════════
         VISTA B – FORMULARIO  (oculta por defecto)
    ══════════════════════════════════════════════════════════════ -->

    <BorderPane fx:id="vistaFormulario" visible="false" managed="false">
        <!-- Cabecera del formulario -->
        <top>
            <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
                <padding><Insets topRightBottomLeft="10"/></padding>
                <Button text="Regresar"
                        onAction="#onCancelarFormulario"><graphic><Icono nombre="izquierda"/></graphic></Button>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="lblTituloForm" text="NUEVO PRODUCTO"
                       styleClass="form-section-title"/>
            </HBox>
        </top>

        <!-- Contenido del formulario centrado y con scroll -->
        <center>
            <ScrollPane fitToWidth="true">
                <!-- .form-scroll centra el formulario como tarjeta sobre el lienzo -->
                <VBox styleClass="form-scroll">
                <VBox styleClass="form-panel" spacing="14"
                      maxWidth="680" alignment="TOP_CENTER">
                    <padding><Insets top="24" right="40" bottom="32" left="40"/></padding>

                    <!-- ── CÓDIGO DE BARRAS ─────────────────────── -->
                    <VBox spacing="4">
                        <Label text="Código de Barras *" styleClass="field-label"/>
                        <TextField fx:id="txtCodigoBarras"
                                   promptText="Escanea o escribe el código"
                                   onKeyReleased="#onCodigoBarrasChanged"/>
                        <HBox fx:id="hboxYaExiste"
                              visible="false" managed="false"
                              spacing="6" alignment="CENTER_LEFT"
                              styleClass="callout, callout-danger">
                            <Label><graphic><Icono nombre="alerta"/></graphic></Label>
                            <VBox spacing="1">
                                <Label text="Este código ya está registrado."
                                       styleClass="text-bold"/>
                                <Label fx:id="lblProductoExistente" text=""
                                       styleClass="field-error-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ── DESCRIPCIÓN ─────────────────────────── -->
                    <VBox spacing="4">
                        <Label text="Descripción *" styleClass="field-label"/>
                        <TextField fx:id="txtDescripcion"
                                   promptText="Nombre del producto"/>
                    </VBox>

                    <!-- ── IMAGEN (opcional) ───────────────────── -->
                    <VBox spacing="4">
                        <Label text="Imagen (opcional)" styleClass="field-label"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <!-- Zona de arrastrar y soltar; doble clic = elegir archivo -->
                            <StackPane fx:id="zonaImagen" styleClass="imagen-zona"
                                       minWidth="160" minHeight="160" maxWidth="160" maxHeight="160">
                                <ImageView fx:id="imgProducto" fitWidth="150" fitHeight="150"
                                           preserveRatio="true" smooth="true"/>
                                <Label fx:id="lblSinImagen" text="Sin imagen&#10;&#10;Arrastra aquí una foto&#10;o elige un archivo"
                                       textAlignment="CENTER" wrapText="true" styleClass="hint"/>
                            </StackPane>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Button text="Elegir archivo…"             onAction="#onElegirImagen"   maxWidth="Infinity"><graphic><Icono nombre="carpeta"/></graphic></Button>
                                <Button text="Pegar del portapapeles"      onAction="#onPegarImagen"    maxWidth="Infinity"><graphic><Icono nombre="lista"/></graphic></Button>
                                <Button text="Desde una dirección (URL)…"  onAction="#onImagenDesdeUrl" maxWidth="Infinity"><graphic><Icono nombre="mundo"/></graphic></Button>
                                <Button fx:id="btnQuitarImagen" text="Quitar imagen" onAction="#onQuitarImagen"
                                        styleClass="button-danger" maxWidth="Infinity" disable="true"><graphic><Icono nombre="eliminar"/></graphic></Button>
                                <Label fx:id="lblImagenEstado"
                                       text="JPG o PNG hasta 10 MB. Se guarda reducida (512 px) en la base de datos."
                                       wrapText="true" styleClass="hint"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ── TIPO DE VENTA ───────────────────────── -->
                    <VBox spacing="6">
                        <Label text="Se vende" styleClass="field-label"/>
                        <RadioButton fx:id="rbUnidad"
                                     text="Por Unidad / Pieza"
                                     selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="toggleTipoVenta"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbGranel"
                                     text="A Granel  (usa decimales)"
                                     toggleGroup="$toggleTipoVenta"/>
                        <RadioButton fx:id="rbPaquete"
                                     text="Como Paquete (kit)"
                                     toggleGroup="$toggleTipoVenta"/>
                    </VBox>

                    <!-- ── UNIDAD DE MEDIDA (catálogo de Configuración) ── -->
                    <VBox spacing="4">
                        <Label text="Unidad de medida" styleClass="field-label"/>
                        <ComboBox fx:id="comboUnidad" maxWidth="Infinity"/>
                    </VBox>

                    <Separator/>

                    <!-- ── PRECIOS ─────────────────────────────── -->
                    <Label text="Precios" styleClass="form-subsection-title"/>

                    <GridPane hgap="16" vgap="10">
                        <Label text="Precio Costo *"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="field-label"/>
                        <TextField fx:id="txtPrecioCosto" promptText="0.00"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"
                                   onKeyReleased="#onValidarPrecio"/>

                        <Label text="Precio Venta *"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"
                               styleClass="field-label"/>
                        <TextField fx:id="txtPrecioVenta" promptText="0.00"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   onKeyReleased="#onValidarPrecio"/>

                        <Label text="Precio Mayoreo"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"
                               styleClass="field-label"/>
                        <TextField fx:id="txtPrecioMayoreo" promptText="0.00"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"
                                   onKeyReleased="#onValidarPrecio"/>

                        <columnConstraints>
                            <ColumnConstraints prefWidth="160" minWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <Label fx:id="lblErrorPrecio"
                           text="Los precios no pueden ser negativos."
                           visible="false" managed="false"
                           styleClass="field-error-label"><graphic><Icono nombre="alerta"/></graphic></Label>

                    <Separator/>

                    <!-- ── DEPARTAMENTO ────────────────────────── -->
                    <VBox spacing="4">
                        <Label text="Departamento" styleClass="field-label"/>
                        <ComboBox fx:id="comboDepartamento"
                                  promptText="— Sin Departamento —"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <Separator/>

                    <!-- ── DATOS FISCALES (CFDI 4.0; opcionales) ── -->
                    <Label text="Facturación (claves del SAT, opcionales)" styleClass="form-subsection-title"/>
                    <GridPane hgap="16" vgap="10">
                        <Label text="Clave producto/servicio"
                               GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="field-label"/>
                        <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <TextField fx:id="txtClaveProdServ" promptText="8 dígitos, ej. 50000000" HBox.hgrow="ALWAYS"/>
                            <Button text="Buscar…" onAction="#onBuscarClaveProdServ"/>
                        </HBox>
                        <Label text="Clave de unidad"
                               GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="field-label"/>
                        <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <TextField fx:id="txtClaveUnidad" promptText="ej. H87, KGM, LTR" HBox.hgrow="ALWAYS"/>
                            <Button text="Buscar…" onAction="#onBuscarClaveUnidad"/>
                        </HBox>
                        <Label text="Objeto de impuesto"
                               GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="field-label"/>
                        <ComboBox fx:id="comboObjetoImp" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <columnConstraints>
                            <ColumnConstraints prefWidth="160" minWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>
                    <Label fx:id="lblClavesDefecto" wrapText="true" styleClass="hint"/>

                    <Separator/>

                    <!-- ── INVENTARIO ──────────────────────────── -->
                    <Label text="Inventario" styleClass="form-subsection-title"/>

                    <CheckBox fx:id="chkUsaInventario"
                              text="Este producto SÍ utiliza inventario"
                              selected="true"
                              onAction="#onToggleInventario"/>

                    <GridPane fx:id="gridInventario" hgap="16" vgap="10">
                        <Label text="Cantidad Actual"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"
                               styleClass="field-label"/>
                        <TextField fx:id="txtCantidadActual" promptText="0"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"
                                   onKeyReleased="#onValidarInventario"/>

                        <Label text="Cantidad Mínima"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"
                               styleClass="field-label"/>
                        <TextField fx:id="txtCantidadMinima" promptText="0"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   onKeyReleased="#onValidarInventario"/>

                        <Label text="(Alerta cuando el stock llegue a este valor)"
                               styleClass="hint"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"
                               GridPane.columnSpan="2"/>

                        <Label fx:id="lblAvisoStock"
                               text="La existencia de este producto se modifica desde Inventario (F4) o con las ventas."
                               visible="false" managed="false" wrapText="true"
                               styleClass="hint"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"
                               GridPane.columnSpan="2"/>

                        <columnConstraints>
                            <ColumnConstraints prefWidth="160" minWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <Label fx:id="lblErrorInventario"
                           text="Las cantidades no pueden ser negativas."
                           visible="false" managed="false"
                           styleClass="field-error-label"><graphic><Icono nombre="alerta"/></graphic></Label>

                    <Region minHeight="12"/>

                    <!-- ── BOTONES FINALES ─────────────────────── -->
                    <HBox spacing="12">
                        <Button fx:id="btnGuardar"
                                text="Guardar Producto"
                                onAction="#onGuardarProducto"
                                styleClass="button-success"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                prefHeight="38"><graphic><Icono nombre="listo"/></graphic></Button>
                        <Button fx:id="btnCancelarForm"
                                text="Cancelar"
                                onAction="#onCancelarFormulario"
                                styleClass="button-danger"
                                prefHeight="38"><graphic><Icono nombre="cerrar"/></graphic></Button>
                    </HBox>

                </VBox>
                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>

       <!-- vista de departamentos  (ocualta ) -->

    <BorderPane fx:id="vistaDepartamentos"   visible="false" managed="false">

        <!-- Cabecera de la ventana -->
        <top>
            <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
                <padding><Insets topRightBottomLeft="10"/></padding>
                <Button text="Regresar"
                        onAction="#onCancelarDepartamento"><graphic><Icono nombre="izquierda"/></graphic></Button>
                <Separator orientation="VERTICAL"/>
                <!-- Titulo de la ventana -->
                <Label  text="Departamentos"
                       styleClass="form-section-title"/>
            </HBox>
        </top>

        <!-- Contenido de la ventana deividido ?  -->
        <center>

        <SplitPane dividerPositions="0.4">

            <VBox spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <padding><Insets top="0" right="10" bottom="8" left="10"/></padding>

                    <Label><graphic><Icono nombre="buscar"/></graphic></Label>

                    <TextField fx:id="txtBuscarDepartamento"
                               promptText="Buscar departamento..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#onBuscarDepartamento"/>
                </HBox>

                    <TableView fx:id="tablaDepartamentos">
                    <columns>
                        <TableColumn fx:id="colNombreDepartamento"       text="Nombre"       prefWidth="140"/>
                    </columns>

                    <placeholder>
                        <Label text="No hay Departamentos registrados. intente registrar un nuevo Departamento."/>
                    </placeholder>

                </TableView>    
            </VBox>

            <VBox>
            
                <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">

                    <padding><Insets topRightBottomLeft="10"/></padding>

                    <Button fx:id="btnNuevoDepartamento"      text="+ Nuevo Departamento"
                            onAction="#onNuevoDepartamento"   styleClass="button-success"/>

             
                    <Button fx:id="btnEliminarDepartamento"   text="Eliminar"
                            onAction="#onEliminarDepartamento" styleClass="button-danger"><graphic><Icono nombre="eliminar"/></graphic></Button>
                    
                </HBox>

                    <Separator orientation="VERTICAL"/>
    
                    <Label text="DETALLES DEL DEPARTAMENTO" styleClass="form-section-title">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding> 
                    </Label>
    
    
                    <Label text="Nombre del Departamento:" styleClass="field-label">
                        <padding><Insets top="10" right="10" bottom="0" left="10"/></padding>
                    </Label>
                    <TextField fx:id="txtNombreDepartamento" promptText="Escribe el nombre del departamento"
                                onKeyReleased="#onValidarDepartamento" HBox.hgrow="ALWAYS">
                        <padding><Insets top="0" right="10" bottom="10" left="10"/></padding>
                    </TextField>
    
                    <Label fx:id="lblErrorDepartamento"
                            text="El nombre no puede estar vacío."
                            visible="false" managed="false"
                            styleClass="field-error-label"><graphic><Icono nombre="alerta"/></graphic>
                        <padding><Insets top="0" right="10" bottom="10" left="10"/></padding>
                    </Label>

                <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">

                    <padding><Insets topRightBottomLeft="10"/></padding>

                    <Button fx:id="btnGuardarDepartamento"      text="+ Guardar Departamento"
                            onAction="#onGuardarDepartamento"   styleClass="button-success"/>

                    <Button fx:id="btnCancelarDepartamento"   text="Cancelar"
                            onAction="#onCancelarDepartamento" styleClass="button-danger"><graphic><Icono nombre="cerrar"/></graphic></Button>
                </HBox>
            
            </VBox>
            
        </SplitPane>

        </center>

    </BorderPane>

</StackPane>
