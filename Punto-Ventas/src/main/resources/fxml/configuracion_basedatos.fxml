<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.EtiquetaBeta?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    configuracion_basedatos.fxml  –  Información, respaldo y restauración de la BD,
    y modo de trabajo de esta caja (una sola caja con SQLite o varias cajas contra un servidor PostgreSQL)
    Controlador: ConfiguracionBaseDatosController.java
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.ConfiguracionBaseDatosController"
            stylesheets="@../css/app.css">

    <fx:define>
        <ToggleGroup fx:id="grupoModo"/>
    </fx:define>

    <center>
        <!-- Dos columnas (datos, respaldo y restaurar | cajas y servidor): cabe en 1024×768 sin desplazar -->
        <ScrollPane fitToWidth="true">
            <HBox spacing="24">
                <padding><Insets top="16" right="20" bottom="12" left="20"/></padding>

                <!-- ── Izquierda: el archivo, respaldo y restaurar ── -->
                <VBox styleClass="form-panel" spacing="10" HBox.hgrow="ALWAYS" prefWidth="420" minWidth="0">
                    <Label text="Base de datos" styleClass="form-section-title"/>
                    <VBox spacing="2">
                        <Label fx:id="lblRutaTitulo" text="Archivo" styleClass="field-label"/>
                        <Label fx:id="lblRuta" wrapText="true"/>
                    </VBox>
                    <HBox spacing="24">
                        <VBox spacing="2">
                            <Label text="Tamaño" styleClass="field-label"/>
                            <Label fx:id="lblTamano"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Registros" styleClass="field-label"/>
                            <GridPane fx:id="gridRegistros" hgap="12" vgap="2"/>
                        </VBox>
                    </HBox>

                    <Separator/>
                    <Label text="Respaldo" styleClass="form-section-title"/>
                    <Label fx:id="lblRespaldoHint" text="Crea una copia completa de la base de datos en el lugar que elijas. Lo ideal es una memoria USB u otro disco: si falla el disco de esta PC, el respaldo sobrevive. El respaldo automático diario se configura en Configuración → Respaldo automático."
                           wrapText="true" styleClass="hint"/>
                    <TextArea fx:id="txtRespaldoServidor" editable="false" wrapText="true" prefRowCount="7"
                              managed="false" visible="false"/>
                    <Button fx:id="btnRespaldar" text="Respaldar ahora" onAction="#onRespaldar" styleClass="button-primary"
                            maxWidth="Infinity" prefHeight="36"/>

                    <Separator/>
                    <Label text="Restaurar" styleClass="form-section-title"/>
                    <Label fx:id="lblRestaurarHint" text="Reemplaza los datos actuales por los de un respaldo. Antes se guarda una copia de seguridad de la base actual y se pide la contraseña del administrador. Los cambios se aplican al reiniciar el programa."
                           wrapText="true" styleClass="hint"/>
                    <Label fx:id="lblPendiente" wrapText="true" styleClass="callout, callout-warning"
                           text="Hay una restauración pendiente: reinicia el programa para aplicarla."
                           managed="false" visible="false"/>
                    <Button fx:id="btnRestaurar" text="Restaurar respaldo..." onAction="#onRestaurar" styleClass="button-danger"
                            maxWidth="Infinity" prefHeight="36"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- ── Derecha: una caja o varias ── -->
                <VBox styleClass="form-panel" spacing="8" HBox.hgrow="ALWAYS" prefWidth="440" minWidth="0">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Cajas y servidor" styleClass="form-section-title"/>
                        <EtiquetaBeta funcion="VARIAS_CAJAS"/>
                    </HBox>
                    <Label fx:id="lblModoActual" wrapText="true" styleClass="hint"/>
                    <RadioButton fx:id="rbUnaCaja" text="Una sola caja (base de datos SQLite en este equipo)"
                                 toggleGroup="$grupoModo" onAction="#onCambiarModo"/>
                    <RadioButton fx:id="rbVariasCajas" text="Varias cajas (servidor PostgreSQL en la red local)"
                                 toggleGroup="$grupoModo" onAction="#onCambiarModo" contentDisplay="RIGHT">
                        <graphic><EtiquetaBeta funcion="VARIAS_CAJAS"/></graphic>
                    </RadioButton>
                    <GridPane fx:id="gridServidor" hgap="8" vgap="6">
                        <padding><Insets left="24"/></padding>
                        <columnConstraints>
                            <ColumnConstraints/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints/>
                            <ColumnConstraints/>
                        </columnConstraints>
                        <Label text="Servidor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtHost" promptText="IP o nombre, ej. 192.168.1.10" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Puerto:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <TextField fx:id="txtPuerto" text="5432" prefWidth="70" maxWidth="70" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Base de datos:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtBase" text="puntodeventa" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                        <Label text="Usuario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtUsuario" text="puntodeventa" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                        <Label text="Contraseña:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="txtContrasena" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Button fx:id="btnProbar" text="Probar conexión" onAction="#onProbarConexion"
                                GridPane.rowIndex="3" GridPane.columnIndex="2" GridPane.columnSpan="2"/>
                        <Label fx:id="lblPrueba" wrapText="true" styleClass="hint" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="4"/>
                    </GridPane>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints/>
                            <ColumnConstraints/>
                            <ColumnConstraints/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Número de esta caja:" minWidth="-Infinity" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="spnCaja" prefWidth="80" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Nombre:" minWidth="-Infinity" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <TextField fx:id="txtCajaNombre" promptText="ej. Caja 1, Mostrador" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                    </GridPane>
                    <Label text="Cada caja debe tener un número distinto. La contraseña del servidor se guarda ofuscada en la carpeta de datos de este usuario (no es un cifrado seguro). Los cambios aplican al reiniciar el programa."
                           wrapText="true" styleClass="hint"/>
                    <Button fx:id="btnGuardarConexion" text="Guardar conexión y caja" onAction="#onGuardarConexion"
                            styleClass="button-primary" maxWidth="Infinity" prefHeight="36"/>
                    <Label fx:id="lblMigrarHint" wrapText="true" styleClass="hint"
                           text="¿Esta caja ya tiene ventas en el archivo local y la tienda va a tener varias cajas? Copia todos los datos del archivo a una base de datos VACÍA del servidor (los datos del servidor capturados arriba). El archivo local no se toca: queda como respaldo."/>
                    <Button fx:id="btnMigrar" text="Migrar datos de esta caja al servidor..." onAction="#onMigrar"
                            maxWidth="Infinity" prefHeight="36"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="8" right="20" bottom="12" left="20"/></padding>
            <Button text="Cerrar" onAction="#onCerrar" prefWidth="140" prefHeight="36"/>
        </HBox>
    </bottom>

</BorderPane>
