<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    corte.fxml  –  Corte de caja
    Controlador: CorteController.java
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.CorteController">

    <top>
        <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <Button fx:id="btnHacerCorte" text="Hacer Corte de Hoy" onAction="#onHacerCorte"
                    styleClass="button-primary"><graphic><Icono nombre="tijeras"/></graphic></Button>
            <Button text="Imprimir Corte"     onAction="#onImprimirCorte"><graphic><Icono nombre="impresora"/></graphic></Button>
            <Button fx:id="btnCorregirFondo" text="Corregir fondo" onAction="#onCorregirFondo"><graphic><Icono nombre="editar"/></graphic></Button>
            <Button fx:id="btnCorteGeneral" text="Σ Corte general (todas las cajas)" onAction="#onCorteGeneral"/>
            <Label fx:id="lblCaja" text="Caja 1" styleClass="badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUltimoCorte" text="Hoy no se ha hecho ningún corte." wrapText="true"
                   styleClass="hint"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <!-- Cada sección es una tarjeta (.card) sobre el lienzo; dos columnas iguales -->
            <GridPane hgap="16" vgap="16">
                <padding><Insets topRightBottomLeft="20"/></padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Columna 0: Entradas de efectivo -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Entradas de Efectivo" styleClass="corte-section-title"/>
                    <!-- "Entrada de dinero (cambio)" y "Pago a proveedores" se agregarán cuando existan
                         entradas/salidas de efectivo; mientras tanto no se muestran filas siempre en $0 -->
                    <GridPane hgap="16" vgap="4">
                        <Label text="Dinero inicial en caja (fondo):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDineroInicial"   text="\$0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Total:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="corte-total-label"/>
                        <Label fx:id="lblTotalEntradas"   text="\$0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="corte-total-value"/>
                    </GridPane>
                </VBox>

                <!-- Columna 1: Dinero en Caja -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Dinero en Caja" styleClass="corte-section-title"/>
                    <GridPane hgap="16" vgap="4">
                        <Label text="Fondo inicial:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEntradas"       text="\$0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Ventas en efectivo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblVentasEfectivo" text="\$0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Total esperado:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="corte-total-label"/>
                        <Label fx:id="lblTotalCaja"      text="\$0.00" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="corte-total-value"/>
                    </GridPane>
                </VBox>

                <!-- Fila 1: Pagos de contado / IVA y Ventas por Departamento -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Pagos de Contado" styleClass="corte-section-title"/>
                    <GridPane hgap="16" vgap="4">
                        <Label text="Efectivo:"           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEfectivo"        text="\$0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Tarjeta crédito/débito:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTarjeta"         text="\$0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Subtotal (sin IVA):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblSubtotal"        text="\$0.00" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="IVA incluido:"       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblIva"             text="\$0.00" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label fx:id="lblTransferenciaTitulo" text="Transferencia:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTransferencia"   text="\$0.00" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label fx:id="lblValesTitulo"     text="Vales:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label fx:id="lblVales"           text="\$0.00" GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="corte-value"/>
                        <Label text="Ventas canceladas:"  GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCanceladas"      text="0"      GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="corte-value"/>
                    </GridPane>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Ventas por Departamento" styleClass="corte-section-title"/>
                    <TableView fx:id="tablaDepartamentos" prefHeight="160">
                        <columns>
                            <TableColumn fx:id="colDepto"   text="Departamento" prefWidth="180"/>
                            <TableColumn fx:id="colMonto"   text="Monto"        prefWidth="120" styleClass="align-right"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Fila 2: productos bajos (INV-03) -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Productos en o por debajo del mínimo" styleClass="corte-section-title"/>
                    <TableView fx:id="tablaBajos" prefHeight="160">
                        <columns>
                            <TableColumn fx:id="colBajoDescripcion" text="Producto" prefWidth="300"/>
                            <TableColumn fx:id="colBajoActual"      text="Existencia" prefWidth="100" styleClass="align-right"/>
                            <TableColumn fx:id="colBajoMinimo"      text="Mínimo"     prefWidth="100" styleClass="align-right"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Fila 3: cobros con tarjeta (voucher capturado en Ventas) -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2" spacing="8" styleClass="card" maxWidth="Infinity">
                    <Label text="Cobros con tarjeta del día" styleClass="corte-section-title"/>
                    <Label fx:id="lblTarjetaTerminales" text="Sin cobros con tarjeta." wrapText="true" styleClass="hint"/>
                    <TableView fx:id="tablaVouchers" prefHeight="170">
                        <columns>
                            <TableColumn fx:id="colVHora"     text="Hora"          prefWidth="70"/>
                            <TableColumn fx:id="colVFolio"    text="Folio"         prefWidth="80"/>
                            <TableColumn fx:id="colVTerminal" text="Terminal"      prefWidth="180"/>
                            <TableColumn fx:id="colVTarjeta"  text="Tarjeta"       prefWidth="90"/>
                            <TableColumn fx:id="colVAut"      text="Autorización"  prefWidth="130"/>
                            <TableColumn fx:id="colVMonto"    text="Monto"         prefWidth="100" styleClass="align-right"/>
                        </columns>
                    </TableView>
                </VBox>

            </GridPane>
        </ScrollPane>
    </center>

    <!-- Totales finales -->
    <bottom>
        <HBox styleClass="corte-footer" spacing="40" alignment="CENTER">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <VBox alignment="CENTER" spacing="4">
                <Label text="Ventas Totales" styleClass="corte-footer-title"/>
                <Label fx:id="lblVentasTotales" text="\$0.00" styleClass="corte-footer-value"/>
            </VBox>
            <Separator orientation="VERTICAL"/>
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="lblGananciaTitulo" text="Ganancia del Día" styleClass="corte-footer-title"/>
                <Label fx:id="lblGanancia"      text="\$0.00" styleClass="corte-footer-value"/>
            </VBox>
        </HBox>
    </bottom>

</BorderPane>
