<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    configuracion.fxml  –  Configuración del sistema
    Controlador: ConfiguracionController.java
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.ConfiguracionController">

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="24">
                <padding><Insets topRightBottomLeft="24"/></padding>

                <!-- ── General ──────────────────────────────────── -->
                <Label text="General" styleClass="config-section-title"/>
                <TilePane hgap="16" vgap="16" prefColumns="4">
                    <Button text="Opciones&#10;Habilitadas"   onAction="#onOpciones"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="ajustes"/></graphic></Button>
                    <Button text="Cajeros"                  onAction="#onCajeros"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="usuario"/></graphic></Button>
                    <Button text="Base de Datos"            onAction="#onBaseDatos"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="baseDatos"/></graphic></Button>
                    <Button text="Artículos&#10;Precargados"   onAction="#onArticulosPrec"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="paquete"/></graphic></Button>
                    <Button text="Facturación"              onAction="#onFacturacion"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="recibo"/></graphic></Button>
                    <Button text="Modificar&#10;Folios"        onAction="#onFolios"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="numeros"/></graphic></Button>
                    <Button text="Ubicación&#10;y Clima"        onAction="#onClima"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="climaSol"/></graphic></Button>
                    <Button text="Acceso&#10;móvil"             onAction="#onAccesoMovil"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="celular"/></graphic></Button>
                </TilePane>

                <Separator/>

                <!-- ── Personalización ──────────────────────────── -->
                <Label text="Personalización" styleClass="config-section-title"/>
                <TilePane hgap="16" vgap="16" prefColumns="4">
                    <Button text="Logotipo"                  onAction="#onLogotipo"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="imagen"/></graphic></Button>
                    <Button text="Ticket"                    onAction="#onTicket"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="boleto"/></graphic></Button>
                    <Button text="Formas de&#10;Pago"           onAction="#onFormasPago"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="tarjeta"/></graphic></Button>
                    <Button text="(%) Impuestos"                  onAction="#onImpuestos"
                            prefWidth="110" prefHeight="80"/>
                    <Button text="($) Moneda"                     onAction="#onMoneda"
                            prefWidth="110" prefHeight="80"/>
                    <Button text="Unidades de&#10;Medida"       onAction="#onUnidades"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="regla"/></graphic></Button>
                </TilePane>

                <Separator/>

                <!-- ── Dispositivos ──────────────────────────────── -->
                <Label text="Dispositivos" styleClass="config-section-title"/>
                <TilePane hgap="16" vgap="16" prefColumns="4">
                    <Button text="Impresora&#10;de Tickets"     onAction="#onImpresora"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="impresora"/></graphic></Button>
                    <Button text="Lector de&#10;Códigos"        onAction="#onLector"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="camara"/></graphic></Button>
                    <Button text="Cajón de&#10;Dinero"          onAction="#onCajon"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="efectivo"/></graphic></Button>
                    <Button text="Báscula"                    onAction="#onBascula"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="bascula"/></graphic></Button>
                    <Button text="Terminal&#10;Bancaria"        onAction="#onTerminalBancaria"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="tarjeta"/></graphic></Button>
                </TilePane>

                <Separator/>

                <!-- ── Mantenimiento ─────────────────────────────── -->
                <Label text="Mantenimiento" styleClass="config-section-title"/>
                <TilePane hgap="16" vgap="16" prefColumns="4">
                    <Button text="Respaldo&#10;Automático"       onAction="#onRespaldo"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="guardar"/></graphic></Button>
                    <Button text="Licencia"                   onAction="#onLicencia"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="llave"/></graphic></Button>
                    <Button text="Actualizaciones"            onAction="#onActualizaciones"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="actualizar"/></graphic></Button>
                    <Button text="Donador y&#10;soporte"        onAction="#onDonador"
                            prefWidth="110" prefHeight="80"><graphic><Icono nombre="corazon"/></graphic></Button>
                </TilePane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
