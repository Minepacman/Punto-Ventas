<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import me.eliassanchezfernandez.puntodeventa.util.BotonOpcion?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    configuracion.fxml  –  Configuración del sistema (pestaña, la última)
    Controlador: ConfiguracionController.java

    Cuatro tarjetas (lo básico, funciones, dispositivos, datos y mantenimiento), cada una con
    un título, una línea que dice qué hay dentro y botones BotonOpcion (icono + título +
    descripción llana). Los botones fluyen en columnas según el ancho (4 a 1024 px); el
    ancho de cada uno está en app.css (.boton-opcion). Cabe en 1024×768 casi sin desplazar.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.ConfiguracionController">

    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="config-page" spacing="8">
                <padding><Insets top="10" right="18" bottom="12" left="18"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Configuración" styleClass="title"/>
                    <Label text="Todo lo del negocio en un solo lugar. Solo el administrador puede cambiar estas opciones."
                           styleClass="subtitle" wrapText="true"/>
                </HBox>

                <!-- ── Lo básico ─────────────────────────────────── -->
                <VBox styleClass="config-card">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="config-card-icon"><graphic><Icono nombre="tienda" tamano="16"/></graphic></Label>
                        <Label text="Lo básico de la tienda" styleClass="config-card-title" minWidth="-Infinity"/>
                        <Label text="Nombre, quién usa la caja, cómo se cobra y cómo sale el ticket." styleClass="hint" textOverrun="ELLIPSIS"/>
                    </HBox>
                    <FlowPane hgap="8" vgap="6">
                        <BotonOpcion icono="tienda"  titulo="Negocio e IVA"       descripcion="Nombre, dirección e IVA" onAction="#onImpuestos"/>
                        <BotonOpcion icono="usuario" titulo="Cajeros"             descripcion="Usuarios y permisos"              onAction="#onCajeros"/>
                        <BotonOpcion icono="tarjeta" titulo="Formas de pago"      descripcion="Efectivo, tarjeta, vales…"       onAction="#onFormasPago"/>
                        <BotonOpcion icono="boleto"  titulo="Ticket"              descripcion="Qué se imprime y cómo se ve"                   onAction="#onTicket"/>
                        <BotonOpcion icono="imagen"  titulo="Logotipo"            descripcion="Imagen del ticket y el inicio"             onAction="#onLogotipo"/>
                        <BotonOpcion icono="numeros" titulo="Folios"              descripcion="Numeración de los tickets"                     onAction="#onFolios"/>
                        <BotonOpcion icono="efectivo" titulo="Moneda"             descripcion="Símbolo y código ($ MXN)"                      onAction="#onMoneda"/>
                        <BotonOpcion icono="regla"   titulo="Unidades de medida"  descripcion="Pieza, kilo, litro, paquete"                  onAction="#onUnidades"/>
                        <BotonOpcion icono="energia" titulo="Abrir al encender"   beta="ABRIR_AL_ENCENDER" descripcion="Iniciar con la computadora"                   onAction="#onAbrirAlEncender"/>
                    </FlowPane>
                </VBox>

                <!-- ── Funciones ─────────────────────────────────── -->
                <VBox styleClass="config-card">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="config-card-icon"><graphic><Icono nombre="energia" tamano="16"/></graphic></Label>
                        <Label text="Funciones" styleClass="config-card-title" minWidth="-Infinity"/>
                        <Label text="Enciende o apaga lo que la tienda usa: celular, clima, facturas, catálogo de productos." styleClass="hint" textOverrun="ELLIPSIS"/>
                    </HBox>
                    <FlowPane hgap="8" vgap="6">
                        <BotonOpcion icono="ajustes"  titulo="Opciones habilitadas"  descripcion="Qué funciones usa la caja"            onAction="#onOpciones"/>
                        <BotonOpcion icono="celular"  titulo="Acceso móvil"          descripcion="Usar el programa en el celular"            onAction="#onAccesoMovil"/>
                        <BotonOpcion icono="climaSol" titulo="Ubicación y clima"     descripcion="Tu ciudad, para sugerir mejor"         onAction="#onClima"/>
                        <BotonOpcion icono="etiqueta" titulo="Códigos de barras"     descripcion="Datos de productos en línea"             onAction="#onCatalogoCodigos"/>
                        <BotonOpcion icono="documento" titulo="Lector de tickets"    beta="LECTOR_TICKETS" descripcion="Leer tickets de proveedor con foto"      onAction="#onLectorTickets"/>
                        <BotonOpcion icono="recibo"   titulo="Facturación"           beta="FACTURACION_CFDI" descripcion="Factura electrónica (CFDI)"              onAction="#onFacturacion"/>
                        <BotonOpcion icono="paquete"  titulo="Artículos precargados" descripcion="Productos de ejemplo"           onAction="#onArticulosPrec"/>
                    </FlowPane>
                </VBox>

                <!-- ── Dispositivos ──────────────────────────────── -->
                <VBox styleClass="config-card">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="config-card-icon"><graphic><Icono nombre="impresora" tamano="16"/></graphic></Label>
                        <Label text="Dispositivos" styleClass="config-card-title" minWidth="-Infinity"/>
                        <Label text="Lo que está conectado a la computadora. Cada pantalla tiene un botón para probarlo." styleClass="hint" textOverrun="ELLIPSIS"/>
                    </HBox>
                    <FlowPane hgap="8" vgap="6">
                        <BotonOpcion icono="impresora" titulo="Impresora de tickets" descripcion="Elegir impresora y probar"        onAction="#onImpresora"/>
                        <BotonOpcion icono="camara"    titulo="Lector de códigos"    descripcion="Probar que escanee bien"                     onAction="#onLector"/>
                        <BotonOpcion icono="efectivo"  titulo="Cajón de dinero"      descripcion="Se abre al cobrar en efectivo"               onAction="#onCajon"/>
                        <BotonOpcion icono="bascula"   titulo="Báscula"              beta="BASCULA" descripcion="Pesar productos a granel"                    onAction="#onBascula"/>
                        <BotonOpcion icono="tarjeta"   titulo="Terminal bancaria"    beta="TERMINAL_BANCARIA" descripcion="Terminales para tarjeta"          onAction="#onTerminalBancaria"/>
                    </FlowPane>
                </VBox>

                <!-- ── Datos y mantenimiento ─────────────────────── -->
                <VBox styleClass="config-card">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="config-card-icon"><graphic><Icono nombre="guardar" tamano="16"/></graphic></Label>
                        <Label text="Datos y mantenimiento" styleClass="config-card-title" minWidth="-Infinity"/>
                        <Label text="Respaldos, versión del programa y soporte." styleClass="hint" textOverrun="ELLIPSIS"/>
                    </HBox>
                    <FlowPane hgap="8" vgap="6">
                        <BotonOpcion icono="guardar"    titulo="Respaldo automático" descripcion="Copias de seguridad diarias"          onAction="#onRespaldo"/>
                        <BotonOpcion icono="baseDatos"  titulo="Base de datos"       descripcion="Restaurar y varias cajas"         onAction="#onBaseDatos"/>
                        <BotonOpcion icono="lista"      titulo="Bitácora"            descripcion="Quién hizo qué y cuándo" onAction="#onBitacora"/>
                        <BotonOpcion icono="actualizar" titulo="Actualizaciones"     descripcion="Versión del programa"                        onAction="#onActualizaciones"/>
                        <BotonOpcion icono="corazon"    titulo="Donador y soporte"   descripcion="Apoya el proyecto, pide ayuda"              onAction="#onDonador"/>
                        <BotonOpcion icono="llave"      titulo="Licencia"            descripcion="Software libre (GPL v3)"                 onAction="#onLicencia"/>
                    </FlowPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
