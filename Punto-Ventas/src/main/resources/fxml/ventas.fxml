<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.VentasController">

    <!-- ── BARRA SUPERIOR: búsqueda de producto ── -->
    <top>
        <HBox styleClass="search-bar" spacing="8" alignment="CENTER_LEFT">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <Label text="Código del Producto:"/>
            <TextField fx:id="txtCodigo" promptText="Escanea o escribe el código"
                       HBox.hgrow="ALWAYS"
                       onAction="#onAgregarProducto"/>
            <Button fx:id="btnAgregar" text="↵ Agregar"
                    onAction="#onAgregarProducto"
                    styleClass="button-success"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnBuscar"    text="🔍 Buscar"      onAction="#onBuscar"/>
            <Button fx:id="btnMayoreo"   text="Mayoreo"        onAction="#onMayoreo"/>
            <Button fx:id="btnDescuento" text="Descuento manual"    onAction="#onDescuentoManual"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnCantidad"  text="Cantidad…"      onAction="#onCambiarCantidad"/>
            <Button fx:id="btnLeerPeso"  text="⚖ Leer peso"    onAction="#onLeerPeso"
                    visible="false" managed="false"/>
            <Button fx:id="btnQuitar"    text="🗑 Quitar"       onAction="#onQuitarLinea"
                    styleClass="button-danger"/>
            <Button fx:id="btnAbrirCajon" text="💰 Abrir cajón"  onAction="#onAbrirCajon"
                    visible="false" managed="false"/>
        </HBox>
    </top>

    <!-- ── TABLA DE PRODUCTOS EN TICKET + SUGERENCIAS ── -->
    <center>
        <VBox spacing="0">
            <TableView fx:id="tablaProductos" styleClass="ticket-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo"        text="Código"      prefWidth="120"/>
                    <TableColumn fx:id="colDescripcion"   text="Descripción" prefWidth="260"/>
                    <TableColumn fx:id="colPrecio"        text="Precio"      prefWidth="85"  styleClass="align-right"/>
                    <TableColumn fx:id="colCantidad"      text="Cant."       prefWidth="70"  styleClass="align-right"/>
                    <TableColumn fx:id="colDescuento"     text="Descuento"   prefWidth="85"  styleClass="align-right"/>
                    <TableColumn fx:id="colTipoDescuento" text="Concepto"    prefWidth="150"/>
                    <TableColumn fx:id="colImporte"       text="Importe"     prefWidth="90"  styleClass="align-right"/>
                    <TableColumn fx:id="colExistencia"    text="Existencia"  prefWidth="85"  styleClass="align-right"/>
                </columns>
            </TableView>

            <!-- Tira compacta de sugerencias (RecomendacionService). Se oculta con la
                 opción "Mostrar sugerencias en venta" de Configuración; el botón solo
                 la pliega durante la sesión. Nunca bloquea el cobro. -->
            <VBox fx:id="boxSugerencias" styleClass="sugerencias-panel" spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Sugerencias"/>
                    <Label fx:id="lblSugerenciasEstado" text="" styleClass="hint"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnOcultarSugerencias" text="Ocultar" onAction="#onOcultarSugerencias"
                            styleClass="button-ghost, button-sm"/>
                </HBox>
                <FlowPane fx:id="contenedorSugerencias" hgap="8" vgap="6"/>
            </VBox>
        </VBox>
    </center>

    <!-- ── PANEL DERECHO: totales y cobro ────────── -->
    <right>
        <VBox styleClass="totales-panel" spacing="10" minWidth="240">
            <padding><Insets topRightBottomLeft="16"/></padding>

            <Label text="TOTAL" styleClass="total-label-title"/>
            <Label fx:id="labelTotal" text="\$0.00" styleClass="total-amount"/>

            <Separator/>

            <!-- Solo se muestran las formas de pago habilitadas en Configuración -->
            <VBox fx:id="boxEfectivo" spacing="4">
                <Label text="Efectivo recibido:"/>
                <TextField fx:id="txtEfectivo" promptText="0.00"
                           onKeyReleased="#onPagoChanged"
                           onAction="#onCobrar"/>
            </VBox>

            <VBox fx:id="boxTarjeta" spacing="4">
                <Label text="Tarjeta:"/>
                <TextField fx:id="txtTarjeta" promptText="0.00"
                           onKeyReleased="#onPagoChanged"
                           onAction="#onCobrar"/>
            </VBox>

            <VBox fx:id="boxTransferencia" spacing="4">
                <Label text="Transferencia:"/>
                <TextField fx:id="txtTransferencia" promptText="0.00"
                           onKeyReleased="#onPagoChanged"
                           onAction="#onCobrar"/>
            </VBox>

            <VBox fx:id="boxVales" spacing="4">
                <Label text="Vales:"/>
                <TextField fx:id="txtVales" promptText="0.00"
                           onKeyReleased="#onPagoChanged"
                           onAction="#onCobrar"/>
            </VBox>

            <FlowPane hgap="6" vgap="6">
                <Button fx:id="btnTodoEfectivo"      text="Todo efectivo"       onAction="#onTodoEfectivo"      styleClass="button-ghost"/>
                <Button fx:id="btnTodoTarjeta"       text="Todo tarjeta"        onAction="#onTodoTarjeta"       styleClass="button-ghost"/>
                <Button fx:id="btnTodoTransferencia" text="Todo transferencia"  onAction="#onTodoTransferencia" styleClass="button-ghost"/>
                <Button fx:id="btnTodoVales"         text="Todo vales"          onAction="#onTodoVales"         styleClass="button-ghost"/>
            </FlowPane>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Pagado:"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelPagado" text="\$0.00"/>
            </HBox>

            <Label text="Cambio:"/>
            <Label fx:id="labelCambio" text="\$0.00" styleClass="cambio-label"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnCobrar" text="F12 · Cobrar"
                    onAction="#onCobrar"
                    maxWidth="Infinity"
                    styleClass="button-primary, btn-cobrar"/>

            <Button fx:id="btnCancelar" text="Cancelar ticket"
                    onAction="#onCancelarTicket"
                    maxWidth="Infinity"
                    styleClass="button-danger"/>
        </VBox>
    </right>

    <!-- ── BARRA INFERIOR: info del ticket ────────── -->
    <bottom>
        <HBox styleClass="ticket-footer" spacing="16" alignment="CENTER_LEFT">
            <padding><Insets top="6" right="12" bottom="6" left="12"/></padding>
            <Label fx:id="labelNumProductos" text="0 productos en la venta actual."/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Vendido hoy:"/>
            <Label fx:id="labelTotalPagado" text="\$0.00"/>
        </HBox>
    </bottom>

</BorderPane>
