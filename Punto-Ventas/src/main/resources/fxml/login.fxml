<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
  Pantalla de inicio de sesión. Un solo "card" con cuatro pasos que se muestran
  uno a la vez (LoginController.mostrarPaso): credenciales, cambio obligatorio
  de contraseña, recuperación del administrador y fondo de caja. El botón
  principal (btnLogin) cambia de texto y acción según el paso. La ventana no es
  redimensionable: el controlador la ajusta al contenido (sizeToScene).
-->
<StackPane fx:id="raiz" styleClass="login-root" stylesheets="@../css/app.css" onKeyPressed="#onTeclaGlobal"
           xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
           fx:controller="me.eliassanchezfernandez.puntodeventa.controller.LoginController">

    <VBox alignment="TOP_CENTER" prefWidth="400" minWidth="380" maxWidth="400" spacing="0" styleClass="login-card">

        <!-- Cabecera: logotipo, negocio, caja y conexión -->
        <VBox alignment="CENTER" spacing="4" styleClass="login-header">
            <padding><Insets bottom="18" left="32" right="32" top="26" /></padding>
            <ImageView fx:id="imgLogo" fitHeight="72" fitWidth="220" managed="false" preserveRatio="true" visible="false" />
            <Label fx:id="lblNombreTienda" styleClass="login-brand-title" text="Caja Libre" textAlignment="CENTER" wrapText="true" />
            <Label fx:id="lblCaja" styleClass="login-brand-subtitle" text="Caja 1" />
            <HBox fx:id="hboxConexion" alignment="CENTER" managed="false" spacing="6" visible="false">
                <Circle fx:id="puntoConexion" radius="5" styleClass="login-conexion-pendiente" />
                <Label fx:id="lblConexion" styleClass="login-conexion" text="Comprobando la conexión con el servidor…" />
            </HBox>
        </VBox>

        <Separator />

        <!-- Paso 1: credenciales -->
        <VBox fx:id="vboxForm" spacing="12" styleClass="login-form">
            <padding><Insets bottom="4" left="32" right="32" top="20" /></padding>

            <FlowPane fx:id="panelUsuarios" hgap="6" managed="false" vgap="6" visible="false" />

            <VBox spacing="4">
                <Label styleClass="field-label" text="Usuario" />
                <TextField fx:id="txtUsuario" onAction="#onEnterUsuario" promptText="Tu usuario" />
            </VBox>

            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="field-label" text="Contraseña" />
                    <Region HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="btnVerContrasena" focusTraversable="false" onAction="#onVerContrasena"
                                  styleClass="login-link-button" text="Mostrar (F8)" />
                </HBox>
                <StackPane>
                    <PasswordField fx:id="txtContrasena" onAction="#onIniciarSesion" promptText="Tu contraseña" />
                    <TextField fx:id="txtContrasenaVisible" managed="false" onAction="#onIniciarSesion" promptText="Tu contraseña" visible="false" />
                </StackPane>
            </VBox>

            <Hyperlink fx:id="lnkOlvide" focusTraversable="false" onAction="#onOlvideContrasena" styleClass="login-link" text="¿Olvidaste tu contraseña?" />
        </VBox>

        <!-- Paso 2: cambio obligatorio de contraseña (primer inicio o restablecida por un admin) -->
        <VBox fx:id="vboxCambioContrasena" managed="false" spacing="10" visible="false">
            <padding><Insets bottom="4" left="32" right="32" top="20" /></padding>
            <Label fx:id="lblCambioTitulo" styleClass="login-step-title" text="Define tu contraseña nueva" wrapText="true" />
            <Label fx:id="lblPoliticaContrasena" styleClass="login-ayuda" text="" wrapText="true" />
            <PasswordField fx:id="txtNuevaContrasena" onAction="#onEnterNuevaContrasena" promptText="Nueva contraseña" />
            <PasswordField fx:id="txtConfirmarContrasena" onAction="#onGuardarNuevaContrasena" promptText="Confirmar contraseña" />
        </VBox>

        <!-- Paso alterno: recuperar la contraseña del administrador con el código de recuperación -->
        <VBox fx:id="vboxRecuperacion" managed="false" spacing="10" visible="false">
            <padding><Insets bottom="4" left="32" right="32" top="20" /></padding>
            <Label styleClass="login-step-title" text="Recuperar contraseña del administrador" wrapText="true" />
            <Label fx:id="lblRecAyuda" styleClass="login-ayuda" wrapText="true"
                   text="Escribe tu usuario de administrador, el código de recuperación que generaste en Configuración → Cajeros y tu contraseña nueva. El código se usa una sola vez." />
            <TextField fx:id="txtRecUsuario" onAction="#onEnterRecUsuario" promptText="Usuario administrador" />
            <TextField fx:id="txtRecCodigo" onAction="#onEnterRecCodigo" promptText="Código de recuperación (ABCD-EFGH-JKMN-PQRS)" />
            <PasswordField fx:id="txtRecNueva" onAction="#onEnterRecNueva" promptText="Contraseña nueva" />
            <PasswordField fx:id="txtRecConfirmar" onAction="#onRestablecer" promptText="Confirmar contraseña nueva" />
        </VBox>

        <!-- Paso 3: fondo de caja del día -->
        <VBox fx:id="vboxFondo" managed="false" spacing="10" visible="false">
            <padding><Insets bottom="4" left="32" right="32" top="20" /></padding>
            <Label fx:id="lblFondoTitulo" styleClass="login-step-title" text="Fondo de caja de hoy" wrapText="true" />
            <Label styleClass="login-ayuda" text="Dinero con el que inicia la caja. Puede ser 0." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="field-label" text="Fondo inicial" />
                <TextField fx:id="txtDineroCaja" HBox.hgrow="ALWAYS" onAction="#onAceptarDineroCaja" promptText="0.00" />
            </HBox>
        </VBox>

        <!-- Pie: avisos, botón principal y ayuda de teclas -->
        <VBox spacing="10">
            <padding><Insets bottom="24" left="32" right="32" top="10" /></padding>

            <HBox fx:id="hboxBloqMayus" alignment="CENTER_LEFT" managed="false" spacing="8" styleClass="callout, callout-warning" visible="false">
                <Label><graphic><Icono nombre="alerta"/></graphic></Label>
                <Label text="Bloq Mayús está activado: la contraseña distingue mayúsculas." wrapText="true" />
            </HBox>

            <HBox fx:id="hboxError" alignment="CENTER_LEFT" managed="false" spacing="8" styleClass="callout, callout-danger" visible="false">
                <Label><graphic><Icono nombre="alerta"/></graphic></Label>
                <Label fx:id="lblError" text="Error." wrapText="true" />
            </HBox>

            <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#onIniciarSesion" styleClass="button-primary, btn-login" text="Iniciar sesión" />

            <ProgressIndicator fx:id="progressLogin" managed="false" prefHeight="24" prefWidth="24" visible="false" />

            <HBox alignment="CENTER" spacing="8">
                <Hyperlink fx:id="lnkVolver" managed="false" onAction="#onVolver" styleClass="login-link" text="Volver (Esc)" visible="false" />
                <Label fx:id="lblAyudaTeclas" styleClass="login-ayuda" text="Enter: continuar · Esc: limpiar" />
            </HBox>
        </VBox>

        <!-- Versión del programa (la pone LoginController desde util/VersionApp) -->
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets bottom="6" left="12" right="12" top="0" /></padding>
            <Label fx:id="lblVersion" styleClass="login-version" text="v1.0.0" />
        </HBox>

    </VBox>

</StackPane>
