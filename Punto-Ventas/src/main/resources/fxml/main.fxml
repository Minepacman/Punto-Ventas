<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane   xmlns:fx="http://javafx.com/fxml"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.MainController"
            stylesheets="@../css/app.css" >

    <top>
        <ToolBar fx:id="toolbar" styleClass="main-toolbar">
            <Label text="Punto de Venta" styleClass="brand-label"/>
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" styleClass="reloj-box">
                <Label fx:id="labelHora" text="--:--" styleClass="reloj-hora"/>
                <Label fx:id="labelFecha" text="—" styleClass="reloj-fecha"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <Label fx:id="labelUsuario" text="Usuario: —"/>

            <Separator orientation="VERTICAL"/>

            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" onAction="#onCerrarSesion"/>

            <Button fx:id="btnSalir" text="Salir" onAction="#onSalir"
                    styleClass="button-danger"/>

        </ToolBar>
    </top>

    <!-- ── NAVEGACIÓN POR PESTAÑAS ───────────────── -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 styleClass="main-tabs">

            <!-- Las pestañas distintas de Ventas se cargan al seleccionarlas por primera vez (MainController.cargarPestanaPerezosa):
                 en PCs lentas evita construir 6 pantallas y consultar la base de datos al iniciar sesión. -->
            <!-- F1 – Ventas -->
            <Tab fx:id="tabVentas" text="F1 · Ventas">
                <fx:include source="ventas.fxml"
                            fx:id="ventasView"/>
            </Tab>

            <!-- F2 – Clientes -->
            <Tab fx:id="tabClientes" text="F2 · Clientes"/>

            <!-- F3 – Productos -->
            <Tab fx:id="tabProductos" text="F3 · Productos"/>

            <!-- F4 – Inventario -->
            <Tab fx:id="tabInventario" text="F4 · Inventario"/>

            <!-- Configuración (solo ADMIN; MainController la quita para cajeros) -->
            <Tab fx:id="tabConfig" text="⚙ Configuración"/>

            <!-- Corte (solo ADMIN) -->
            <Tab fx:id="tabCorte" text="✂ Corte"/>

            <!-- Estadísticas (solo quien tiene VER_HISTORIAL; MainController la quita para los demás) -->
            <Tab fx:id="tabEstadisticas" text="📊 Estadísticas"/>

        </TabPane>
    </center>

    <!-- ── BARRA DE ESTADO INFERIOR ──────────────── -->
    <bottom>
        <HBox styleClass="status-bar" spacing="12">
            <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="F1 Ventas · F2 Clientes · F3 Productos · F4 Inventario · F5 Estadísticas · F12 Cobrar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelVersion" text="v1.0.0"/>
        </HBox>
    </bottom>


</BorderPane>
