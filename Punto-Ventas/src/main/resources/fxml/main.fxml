<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane   xmlns:fx="http://javafx.com/fxml"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.MainController"
            stylesheets="@../css/app.css" >

    <top>
        <ToolBar fx:id="toolbar" styleClass="main-toolbar">
            <Label text="Caja Libre" styleClass="brand-label"/>
            <Region HBox.hgrow="ALWAYS"/>

            <VBox fx:id="relojBox" alignment="CENTER_RIGHT" styleClass="reloj-box">
                <!-- El clima va en el renglón de la hora: la fecha es más ancha, así que casi nunca ensancha la cabecera -->
                <HBox fx:id="filaReloj" alignment="CENTER_RIGHT" spacing="10">
                    <!-- Clima de la hora ("24 °C · Soleado"), del último registro de ClimaService; oculto si el clima
                         está apagado, sin ubicación o si no cabe en el ancho actual (MainController.acomodarClima).
                         El ADMIN lo pulsa para abrir Configuración → Ubicación y clima. -->
                    <Label fx:id="labelClima" text="" styleClass="clima-barra" visible="false" managed="false"
                           onMouseClicked="#onClima"><graphic><Icono nombre="nube" tamano="16"/></graphic></Label>
                    <Label fx:id="labelHora" text="--:--" styleClass="reloj-hora"/>
                </HBox>
                <Label fx:id="labelFecha" text="—" styleClass="reloj-fecha"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <Label fx:id="labelCaja" text="Caja 1" styleClass="badge"/>

            <Separator orientation="VERTICAL"/>

            <Label fx:id="labelUsuario" text="Usuario: —"/>

            <Separator orientation="VERTICAL"/>

            <Button fx:id="btnBloquear" text="Bloquear" onAction="#onBloquear">
                <tooltip><Tooltip text="Volver al inicio de sesión sin cerrar el programa (Ctrl+L). El ticket sin cobrar se conserva."/></tooltip>
            </Button>

            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" onAction="#onCerrarSesion"/>

            <Button fx:id="btnSalir" text="Salir" onAction="#onSalir"
                    styleClass="button-danger"/>

        </ToolBar>
    </top>

    <!-- ── NAVEGACIÓN POR PESTAÑAS ───────────────── -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 styleClass="main-tabs">

            <!-- Las pestañas distintas de Ventas se cargan al seleccionarlas por primera vez (MainController.cargarPestanaPerezosa):
                 en PCs lentas evita construir 6 pantallas y consultar la base de datos al iniciar sesión. -->
            <!-- F1 – Ventas -->
            <Tab fx:id="tabVentas" text="F1 · Ventas"><graphic><Icono nombre="tienda"/></graphic>
                <fx:include source="ventas.fxml"
                            fx:id="ventasView"/>
            </Tab>

            <!-- La pestaña "Clientes" (F2) se mostrará cuando exista el módulo: clientes.fxml y
                 ClientesController se conservan; F2 queda sin asignar. -->

            <!-- F3 – Productos -->
            <Tab fx:id="tabProductos" text="F3 · Productos"><graphic><Icono nombre="etiqueta"/></graphic></Tab>

            <!-- F4 – Inventario -->
            <Tab fx:id="tabInventario" text="F4 · Inventario"><graphic><Icono nombre="paquete"/></graphic></Tab>

            <!-- Corte (solo ADMIN) -->
            <Tab fx:id="tabCorte" text="Corte"><graphic><Icono nombre="tijeras"/></graphic></Tab>

            <!-- Estadísticas (solo quien tiene VER_HISTORIAL; MainController la quita para los demás) -->
            <Tab fx:id="tabEstadisticas" text="Estadísticas"><graphic><Icono nombre="grafica"/></graphic></Tab>

            <!-- Configuración: la ÚLTIMA pestaña (solo ADMIN/GERENTE; MainController la quita para cajeros).
                 No tiene tecla rápida (F1–F5 son las pestañas de trabajo), así que moverla no cambia ningún atajo. -->
            <Tab fx:id="tabConfig" text="Configuración"><graphic><Icono nombre="ajustes"/></graphic></Tab>

        </TabPane>
    </center>

    <!-- ── BARRA DE ESTADO INFERIOR ──────────────── -->
    <bottom>
        <HBox styleClass="status-bar" spacing="12">
            <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- El texto lo arma MainController desde el catálogo util/Atajo -->
            <Label fx:id="labelAtajos" text="F1 Ventas · F3 Productos · F4 Inventario · F5 Estadísticas · F6 Buscar · F11 En espera · F12 Cobrar"/>
            <Hyperlink fx:id="lnkAtajos" text="Atajos F10" onAction="#onAtajos" focusTraversable="false"/>
            <!-- Vuelve a mostrar el recorrido por las pestañas (TutorialGeneralDialogo) -->
            <Hyperlink fx:id="lnkTutorial" text="Tutorial" onAction="#onTutorial" focusTraversable="false">
                <tooltip><Tooltip text="Ver de nuevo el recorrido por las pestañas del programa"/></tooltip>
            </Hyperlink>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Se enciende solo cuando el buscador de actualizaciones encontró una versión nueva -->
            <Hyperlink fx:id="lnkActualizacion" text="Nueva versión disponible" onAction="#onActualizacion"
                       focusTraversable="false" styleClass="status-actualizacion" visible="false" managed="false"><graphic><Icono nombre="nuevaVersion"/></graphic></Hyperlink>
            <Hyperlink fx:id="lnkAcercaDe" text="Acerca de" onAction="#onAcercaDe" focusTraversable="false">
                <tooltip><Tooltip text="Versión, donador, soporte técnico y actualizaciones"/></tooltip>
            </Hyperlink>
            <Label fx:id="labelVersion" text="v1.0.0"/>
        </HBox>
    </bottom>


</BorderPane>
