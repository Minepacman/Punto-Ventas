<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import me.eliassanchezfernandez.puntodeventa.controller.SelectorUbicacion?>

<!--
    configuracion_clima.fxml  –  Ubicación del negocio y clima
    Controlador: ConfiguracionClimaController.java

    La ubicación se elige con SelectorUbicacion (detectar por internet, buscar la ciudad o, en
    Opciones avanzadas, coordenadas a mano). El clima es un interruptor.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.ConfiguracionClimaController"
            stylesheets="@../css/app.css">

    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="form-panel" spacing="12">
                <padding><Insets top="18" right="22" bottom="16" left="22"/></padding>

                <Label text="¿Dónde está tu negocio?" styleClass="form-section-title"/>
                <Label text="Con la ciudad, el programa sabe el clima de tu zona y lo relaciona con tus ventas para sugerir mejor. Solo se usa la zona, nunca la dirección exacta."
                       wrapText="true" styleClass="hint"/>

                <SelectorUbicacion fx:id="selectorUbicacion"/>

                <Separator/>
                <Label text="Clima" styleClass="form-section-title"/>

                <HBox styleClass="fila-interruptor">
                    <ToggleSwitch fx:id="swClima"/>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label text="Registrar el clima cada hora" styleClass="interruptor-titulo"/>
                        <Label text="Temperatura y condición del tiempo de tu zona (servicio gratuito Open-Meteo). Se enciende solo cuando ya hay ubicación."
                               wrapText="true" styleClass="hint"/>
                    </VBox>
                </HBox>

                <HBox styleClass="callout, callout-info" alignment="CENTER_LEFT">
                    <Label text="Privacidad: al servicio de clima solo se envían las coordenadas de la zona. Ninguna venta, producto ni dato del negocio sale de este equipo. Sin internet el programa funciona igual y muestra «Sin datos de clima»."
                           wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnProbar" text="Probar conexión" onAction="#onProbar"/>
                    <Label fx:id="lblEstado" text="" wrapText="true" styleClass="hint" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Region minHeight="4"/>

                <HBox spacing="12">
                    <Button text="Guardar" onAction="#onGuardar" styleClass="button-primary"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"/>
                    <Button text="Cerrar" onAction="#onCerrar" prefHeight="38"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
