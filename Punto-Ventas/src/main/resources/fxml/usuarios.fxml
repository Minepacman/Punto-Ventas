<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    usuarios.fxml  –  Administración de usuarios, roles y permisos
    Controlador: UsuariosController.java
    Se abre como ventana modal desde Configuración → Cajeros.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="raiz"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.UsuariosController"
            stylesheets="@../css/app.css">

    <top>
        <HBox styleClass="section-toolbar" spacing="8" alignment="CENTER_LEFT">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <Button fx:id="btnNuevo"       text="+ Nuevo"        onAction="#onNuevo"   styleClass="button-success"/>
            <Button fx:id="btnEstado"      text="⛔ Desactivar"   onAction="#onCambiarEstado"/>
            <Button fx:id="btnDesbloquear" text="🔓 Desbloquear"  onAction="#onDesbloquear"/>
            <Button fx:id="btnEliminar"    text="🗑 Eliminar"     onAction="#onEliminar" styleClass="button-danger"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Usuarios del sistema" styleClass="form-section-title"/>
        </HBox>
    </top>

    <!-- Opciones del inicio de sesión (solo ADMIN) -->
    <bottom>
        <HBox fx:id="barraLogin" alignment="CENTER_LEFT" spacing="12" styleClass="status-bar">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <CheckBox fx:id="chkMostrarEnLogin" text="Mostrar la lista de usuarios en el inicio de sesión" onAction="#onMostrarEnLogin"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCodigoEstado" text=""/>
            <Button fx:id="btnCodigoRecuperacion" text="🔑 Código de recuperación…" onAction="#onCodigoRecuperacion"/>
        </HBox>
    </bottom>

    <center>
        <SplitPane dividerPositions="0.5">

            <!-- Tabla -->
            <TableView fx:id="tablaUsuarios">
                <columns>
                    <TableColumn fx:id="colUsuario" text="Usuario"  prefWidth="110"/>
                    <TableColumn fx:id="colNombre"  text="Nombre"   prefWidth="170"/>
                    <TableColumn fx:id="colRol"     text="Rol"      prefWidth="110"/>
                    <TableColumn fx:id="colActivo"  text="Activo"   prefWidth="55"/>
                    <TableColumn fx:id="colEstado"  text="Estado"   prefWidth="170"/>
                </columns>
            </TableView>

            <!-- Formulario -->
            <ScrollPane fitToWidth="true">
                <VBox fx:id="vboxFormulario" styleClass="form-panel" spacing="12">
                    <padding><Insets topRightBottomLeft="16"/></padding>

                    <Label fx:id="lblTituloForm" text="NUEVO USUARIO" styleClass="form-section-title"/>
                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Usuario (para iniciar sesión) *" styleClass="field-label"/>
                        <TextField fx:id="txtUsuario" promptText="ej: maria"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Nombre completo *" styleClass="field-label"/>
                        <TextField fx:id="txtNombre" promptText="ej: María López"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Contraseña" styleClass="field-label"/>
                        <PasswordField fx:id="txtContrasena"/>
                        <Label fx:id="lblAyudaContrasena" text="" wrapText="true"
                               styleClass="hint"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Rol *" styleClass="field-label"/>
                        <ComboBox fx:id="comboRol" maxWidth="Infinity"/>
                        <Label text="Administrador: todo. Gerente: edita productos y desactiva usuarios. Cajero: ventas e inventario básico. Los permisos de abajo ajustan lo que el rol permite."
                               wrapText="true" styleClass="hint"/>
                    </VBox>

                    <CheckBox fx:id="chkActivo" text="Usuario activo (puede iniciar sesión)"/>

                    <Separator/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Permisos de este usuario" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnPermisosDelRol" text="Los del rol" onAction="#onPermisosDelRol" styleClass="button-ghost"/>
                    </HBox>
                    <VBox fx:id="vboxPermisos" spacing="6"/>

                    <Region minHeight="8"/>

                    <HBox spacing="12">
                        <Button fx:id="btnGuardar" text="✅ Guardar" onAction="#onGuardar"
                                styleClass="button-success"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"/>
                        <Button text="Cerrar" onAction="#onCerrar" prefHeight="38"/>
                    </HBox>
                </VBox>
            </ScrollPane>

        </SplitPane>
    </center>

</BorderPane>
