<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import me.eliassanchezfernandez.puntodeventa.util.Icono?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    inventario.fxml  –  Gestión de Inventario (F4)
    Controlador: InventarioController.java
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="me.eliassanchezfernandez.puntodeventa.controller.InventarioController">

    <top>
        <VBox>
        <HBox styleClass="section-toolbar" spacing="8">
            <padding><Insets topRightBottomLeft="10"/></padding>
            <Button text="Entrada de mercancía"   onAction="#onAgregar"
                    styleClass="button-success"><graphic><Icono nombre="mas"/></graphic></Button>
            <Button text="Ajustes"                onAction="#onAjustes"><graphic><Icono nombre="bascula"/></graphic></Button>
            <ToggleButton fx:id="btnSoloBajos" text="Productos Bajos"
                          onAction="#onProductosBajos"><graphic><Icono nombre="alerta"/></graphic></ToggleButton>
            <Separator orientation="VERTICAL"/>
            <!-- "Reporte de inventario" (PDF) se mostrará cuando exista; "Exportar…" ya saca CSV/xlsx/PDF -->
            <Button text="Movimientos"            onAction="#onReporteMovimientos"><graphic><Icono nombre="lista"/></graphic></Button>
            <Button text="Exportar…"              onAction="#onExportar"><graphic><Icono nombre="subir"/></graphic></Button>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnProveedores" text="Proveedores"     onAction="#onProveedores"><graphic><Icono nombre="fabrica"/></graphic></Button>
            <Button fx:id="btnOrdenes"     text="Órdenes de compra" onAction="#onOrdenesCompra"><graphic><Icono nombre="recibo"/></graphic></Button>
        </HBox>
        <Label fx:id="lblVisitanHoy" text="" wrapText="true" styleClass="hint">
            <padding><Insets top="6" right="12" bottom="0" left="12"/></padding>
        </Label>
        </VBox>
    </top>

    <center>

        <SplitPane dividerPositions="0.38">

            <!-- Panel izquierdo: formulario de entrada / ajuste -->
            <ScrollPane fitToWidth="true">
            <VBox styleClass="form-panel" spacing="12">
                <padding><Insets topRightBottomLeft="16"/></padding>

                <Label fx:id="lblTituloForm" text="ENTRADA DE MERCANCÍA" styleClass="section-title"/>
                <Separator/>

                <Label text="Código del Producto:"/>
                <TextField fx:id="txtCodigo" promptText="Escanea o escribe..."
                           onAction="#onBuscarProducto"/>

                <Label text="Descripción:"/>
                <Label fx:id="labelDescripcion" text="—" styleClass="info-label" wrapText="true"/>
                <!-- Foto del producto (solo se muestra si tiene) -->
                <StackPane fx:id="marcoImagen" styleClass="imagen-marco" visible="false" managed="false"
                           maxWidth="128" maxHeight="128" minHeight="128">
                    <ImageView fx:id="imgProducto" fitWidth="120" fitHeight="120" preserveRatio="true" smooth="true"/>
                </StackPane>

                <Label text="Cantidad Actual:"/>
                <Label fx:id="labelCantidadActual" text="0.00" styleClass="info-label"/>

                <Label fx:id="lblEtiquetaCantidad" text="Cantidad que entra:"/>
                <TextField fx:id="txtCantidad" promptText="0.00"
                           onAction="#onAgregarCantidad"/>

                <!-- Solo en modo ENTRADA -->
                <VBox fx:id="vboxEntrada" spacing="6">
                    <Label text="Proveedor: *"/>
                    <ComboBox fx:id="cmbProveedor" maxWidth="Infinity" promptText="Elige el proveedor"/>
                    <Label fx:id="lblSinProveedores" text="Aún no hay proveedores: da de alta uno en Proveedores."
                           wrapText="true" styleClass="hint" visible="false" managed="false"/>
                    <Label text="Costo unitario de compra:"/>
                    <TextField fx:id="txtCosto" promptText="0.00"/>
                    <Label text="El costo del producto se actualiza con el de esta entrada."
                           wrapText="true" styleClass="hint"/>
                </VBox>

                <!-- Solo en modo AJUSTE -->
                <VBox fx:id="vboxAjuste" spacing="6" visible="false" managed="false">
                    <Label text="Motivo del ajuste: *"/>
                    <ComboBox fx:id="comboMotivo" maxWidth="Infinity" promptText="Merma, robo, caducidad, conteo..."/>
                </VBox>

                <Button fx:id="btnAplicar"
                        text="Registrar entrada"
                        onAction="#onAgregarCantidad"
                        styleClass="button-success"
                        maxWidth="Infinity"><graphic><Icono nombre="listo"/></graphic></Button>

                <Label text="Las filas en amarillo están en o por debajo del mínimo; en rojo, agotadas. Todo movimiento queda registrado."
                       wrapText="true" styleClass="hint"/>
            </VBox>
            </ScrollPane>

            <!-- Panel derecho: tabla de productos con inventario -->
            <TableView fx:id="tablaInventario">

                <columns>
                    <TableColumn fx:id="colCodigo"      text="Código"     prefWidth="130"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="260"/>
                    <TableColumn fx:id="colActual"      text="Actual"      prefWidth="90" styleClass="align-right"/>
                    <TableColumn fx:id="colMinimo"      text="Mínimo"      prefWidth="90" styleClass="align-right"/>
                    <TableColumn fx:id="colEstado"      text="Estado"      prefWidth="100"/>
                </columns>

            </TableView>

        </SplitPane>

    </center>

</BorderPane>
